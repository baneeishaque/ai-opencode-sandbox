# Services-agent + runners — required values (copy to .env and fill).
# Compose auto-loads .env from this directory; every ${VAR:?} below is
# enforced at BOTH docker compose build (build.args) and docker compose up
# (environment). No defaults exist — missing values abort with a named error.

# Services-agent
GITHUB_PAT=<github-pat>  # read access to the private repos

# Repo URLs (clone-repos.bash clones these into /workspace)
AI_REPO_URL=<ai-repo-url>
FRONTEND_REPO_URL=<frontend-repo-url>
BACKEND_REPO_URL=<backend-repo-url>
TESTS_REPO_URL=<tests-repo-url>
DB_REPO_URL=<db-repo-url>
DB_DUMP_PATH=<db-dumps-path>  # dumps dir INSIDE the db repo (e.g. the db_dumps/ dir at /workspace/db/<dir>)
GIT_USER_NAME=<git-user-name>  # identity for commits made by the sandbox
GIT_USER_EMAIL=<git-user-email>
BACKEND_PROJECT_DIR=<backend-project-dir>  # Django project dir INSIDE the backend repo (e.g. the project/ dir at /workspace/backend/<dir>)
# Optional: opencode plugins folder RELATIVE to the ai-repo root. Unset =
# skip plugin linking; set but folder missing = hard error at boot.
# OPENCODE_PLUGIN_DIR=<opencode-plugins-dir>

# Runner — one registration per repo. Only repos where the token has admin
# can host runners; write-only repos stay commented until admin is granted.
GIT_PUSH_TOKEN=<push-token>
RUNNER_E2E_REPO_URL=<e2e-repo-url>
RUNNER_E2E_TOKEN=<fresh-registration-token>
RUNNER_DB_REPO_URL=<db-repo-url>
RUNNER_DB_TOKEN=<fresh-registration-token>
# RUNNER_FRONTEND_REPO_URL=<frontend-repo-url>
# RUNNER_FRONTEND_TOKEN=<fresh-registration-token>
# RUNNER_BACKEND_REPO_URL=<backend-repo-url>
# RUNNER_BACKEND_TOKEN=<fresh-registration-token>

# Optional override (default is generic):
# APP_DUMP_NAME=<app-dump-name>
